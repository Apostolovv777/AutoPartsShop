<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoPartsShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoPartsShop.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark custom-navbar mb-3">
            <div class="container-fluid">

                <!-- ЛОГО -->
                <a class="navbar-brand fw-bold text-danger" asp-area="" asp-controller="Home" asp-action="Index">
                    🚗 AutoPartsShop
                </a>

                <!-- MOBILE BUTTON -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">Продукти</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Order" asp-action="MyOrders">Поръчки</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">За нас</a>
                        </li>

                    </ul>

                    <!-- ДЯСНА ЧАСТ -->
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link cart-link" href="/Cart">
                                🛒 Количка
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>

        <style>
            .custom-navbar {
                background-color: #0b0b0b;
                border-bottom: 2px solid #ff1a1a;
            }

            .navbar-brand {
                font-size: 22px;
                letter-spacing: 1px;
            }

            .nav-link {
                color: #ccc !important;
                margin: 0 10px;
                transition: 0.3s;
            }

                .nav-link:hover {
                    color: #ff1a1a !important;
                    transform: scale(1.05);
                }

            .cart-link {
                background: #ff1a1a;
                padding: 6px 15px;
                border-radius: 8px;
                color: white !important;
                font-weight: bold;
            }

                .cart-link:hover {
                    background: #cc0000;
                }
        </style>

                        <li class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Products
                            </button>

                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Vw">VW</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Bmw">BMW</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Mercedes">MERCEDES</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Audi">AUDI</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Toyota">TOYOTA</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Honda">HONDA</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Opel">OPEL</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-searchStringBrandName="Seat">SEAT</a></li>
                            </ul>
                        </li>

                        @if ((this.User.Identity.IsAuthenticated) && (this.User.IsInRole("Administrator")))
                        {
                            <li class="dropdown">
                                <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    Statistic Modul
                                </button>

                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                                    <li><a class="dropdown-item" href="/Client/index">Clients</a></li>
                                    <li><a class="dropdown-item" href="/Order/Index">Orders</a></li>
                                    <li><a class="dropdown-item" href="/Statistic/Index">Statistic</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AutoPartsShop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
