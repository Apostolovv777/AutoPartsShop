@{
    ViewData["Title"] = "Success";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Poppins', sans-serif;
    }

    .success-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .success-card {
        width: 100%;
        max-width: 650px;
        background: white;
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        padding: 40px 32px;
        text-align: center;
    }

    .success-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: linear-gradient(135deg, #16a34a, #22c55e);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 36px;
        box-shadow: 0 12px 24px rgba(34, 197, 94, 0.22);
    }

    .success-title {
        font-size: 38px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 12px;
    }

    .success-text {
        color: #6b7280;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 28px;
    }

    .success-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-main {
        background: #111827;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 22px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
        display: inline-block;
    }

    .btn-main:hover {
        background: #2563eb;
        color: white;
    }

    .btn-outline {
        background: white;
        color: #111827;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 12px 22px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
        display: inline-block;
    }

    .btn-outline:hover {
        background: #f3f4f6;
        color: #111827;
    }

    @@media (max-width: 575.98px) {
        .success-title {
            font-size: 30px;
        }

        .success-card {
            padding: 30px 20px;
        }
    }
</style>

<div class="success-page">
    <div class="success-card">
        <div class="success-icon">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1 class="success-title">Success!</h1>

        <p class="success-text">
            The selected item was removed successfully from the system.
        </p>

        <div class="success-actions">
            <a asp-action="Index" class="btn-main">Back to List</a>
            <a asp-controller="Home" asp-action="Index" class="btn-outline">Go to Home</a>
        </div>
    </div>
</div>