@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="login-wrap">
    <div class="login-card">

        <!-- ЛОГО / ЗАГЛАВИЕ -->
        <div class="login-header">
            <div class="login-icon">
                <i class="fas fa-user"></i>
            </div>
            <h1 class="login-title">Добре дошъл</h1>
            <p class="login-sub">Влез в своя акаунт</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>

            <!-- USERNAME -->
            <div class="field-group">
                <label asp-for="Input.UserName" class="field-label">
                    <i class="fas fa-envelope"></i> Потребителско име
                </label>
                <input asp-for="Input.UserName"
                       class="field-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <span asp-validation-for="Input.UserName" class="field-error"></span>
            </div>

            <!-- PASSWORD -->
            <div class="field-group">
                <label asp-for="Input.Password" class="field-label">
                    <i class="fas fa-lock"></i> Парола
                </label>
                <input asp-for="Input.Password"
                       class="field-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <!-- SUBMIT -->
            <button id="login-submit" type="submit" class="btn-login">
                <i class="fas fa-sign-in-alt me-2"></i> Влез в акаунта
            </button>
        </form>

    </div>
</div>

<style>
    .login-wrap {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .login-card {
        background: #0f0f0f;
        border: 1px solid #1e1e1e;
        border-radius: 16px;
        padding: 40px 36px;
        width: 100%;
        max-width: 420px;
    }

    /* HEADER */
    .login-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .login-icon {
        width: 56px;
        height: 56px;
        background: rgba(230, 51, 18, 0.12);
        border: 1px solid rgba(230, 51, 18, 0.25);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e63312;
        font-size: 22px;
        margin: 0 auto 16px;
    }

    .login-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 28px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 1px;
        margin: 0 0 6px;
    }

    .login-sub {
        color: #555;
        font-size: 13px;
        margin: 0;
    }

    /* FIELDS */
    .field-group {
        margin-bottom: 18px;
    }

    .field-label {
        display: block;
        color: #666;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 8px;
        font-family: 'Noto Sans', sans-serif;
    }

        .field-label i {
            color: #e63312;
            margin-right: 6px;
            font-size: 11px;
        }

    .field-input {
        width: 100%;
        background: #141414;
        border: 1px solid #2a2a2a;
        color: #e0e0e0;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 14px;
        font-family: 'Noto Sans', sans-serif;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .field-input::placeholder {
            color: #444;
        }

        .field-input:focus {
            border-color: #e63312;
            box-shadow: 0 0 0 3px rgba(230, 51, 18, 0.1);
        }

    .field-error {
        display: block;
        color: #e63312;
        font-size: 12px;
        margin-top: 5px;
    }

    .alert-error {
        background: rgba(230, 51, 18, 0.08);
        border: 1px solid rgba(230, 51, 18, 0.2);
        color: #e63312;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    /* BUTTON */
    .btn-login {
        width: 100%;
        background: #e63312;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 13px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Noto Sans', sans-serif;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 8px;
    }

        .btn-login:hover {
            background: #c4290e;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
