@model IEnumerable<AutoPartsShop.Infrastructure.Data.Entities.Favourite>

@{
    ViewData["Title"] = "My Favourites";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Poppins', sans-serif;
    }

    .fav-page {
        max-width: 1200px;
        margin: 30px auto;
    }

    .fav-title {
        text-align: center;
        margin-bottom: 25px;
    }

        .fav-title h1 {
            font-weight: 800;
            color: #111827;
        }

        .fav-title p {
            color: #6b7280;
        }

    .fav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 25px;
    }

    .fav-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        transition: 0.25s ease;
    }

        .fav-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.12);
        }

        .fav-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

    .fav-info {
        padding: 15px;
        text-align: center;
    }

        .fav-info h4 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #111827;
        }

    .fav-meta {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .fav-price {
        font-size: 18px;
        font-weight: 700;
        color: #16a34a;
        margin-bottom: 10px;
    }

    .btn-main {
        background: #111827;
        border: none;
        padding: 8px 14px;
        border-radius: 10px;
        color: white;
        text-decoration: none;
        display: inline-block;
        margin-top: 8px;
        transition: 0.2s;
    }

        .btn-main:hover {
            background: #2563eb;
            color: white;
        }

    .btn-remove {
        background: #dc2626;
        border: none;
        padding: 8px 14px;
        border-radius: 10px;
        color: white;
        text-decoration: none;
        display: inline-block;
        margin-top: 8px;
        transition: 0.2s;
    }

        .btn-remove:hover {
            background: #b91c1c;
            color: white;
        }

    .empty-fav {
        text-align: center;
        background: white;
        padding: 40px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    }

        .empty-fav h3 {
            color: #111827;
            margin-bottom: 10px;
        }

        .empty-fav a {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            background: #111827;
            color: white;
            padding: 10px 18px;
            border-radius: 10px;
        }

            .empty-fav a:hover {
                background: #2563eb;
            }
</style>

<div class="fav-page">

    <div class="fav-title">
        <h1>❤️ My Favourites</h1>
        <p>Your saved premium products</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-fav">
            <h3>No favourite products yet</h3>
            <p class="text-muted">Start adding products you like.</p>
            <a asp-controller="Product" asp-action="Index">Go to Products</a>
        </div>
    }
    else
    {
        <div class="fav-grid">
            @foreach (var item in Model)
            {
                var finalPrice = item.Product.Price - (item.Product.Price * item.Product.Discount / 100);

                <div class="fav-card">
                    <img src="@item.Product.Picture" alt="Product Image" />

                    <div class="fav-info">
                        <h4>@item.Product.ProductName</h4>

                        <div class="fav-meta">
                            @item.Product.Brand.BrandName | @item.Product.Category.CategoryName
                        </div>

                        <div class="fav-price">
                            @finalPrice лв.
                        </div>

                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@item.ProductId"
                           class="btn-main">
                            Details
                        </a>

                        <br />

                        <a href="/Cart/AddToCart?id=@item.ProductId&name=@item.Product.ProductName&price=@finalPrice&imageUrl=@item.Product.Picture"
                           class="btn-main">
                            🛒 Add to Cart
                        </a>

                        <br />

                        <a asp-controller="Favourites"
                           asp-action="Remove"
                           asp-route-id="@item.ProductId"
                           class="btn-remove">
                            Remove
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>