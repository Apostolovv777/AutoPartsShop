@model AutoPartsShop.Models.Client.ClientDeleteVM

@{
    ViewData["Title"] = "Delete Client";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Poppins', sans-serif;
    }

    .delete-page {
        max-width: 850px;
        margin: 30px auto;
    }

    .delete-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .delete-header h1 {
        font-weight: 800;
        color: #dc2626;
        margin-bottom: 8px;
    }

    .delete-header p {
        color: #6b7280;
        margin-bottom: 0;
    }

    .delete-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        padding: 25px;
    }

    .warning-box {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 20px;
        font-weight: 600;
        text-align: center;
    }

    .client-preview {
        background: #f9fafb;
        border: 1px solid #eef2f7;
        border-radius: 16px;
        padding: 20px;
    }

    .client-title {
        font-size: 24px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 8px;
    }

    .client-subtitle {
        color: #6b7280;
        margin-bottom: 16px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
        border-bottom: 1px solid #eef2f7;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 700;
        color: #111827;
    }

    .info-value {
        color: #4b5563;
        text-align: right;
    }

    .actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .btn-danger-custom {
        background: #dc2626;
        border: none;
        color: white;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .btn-danger-custom:hover {
        background: #b91c1c;
    }

    .btn-outline-custom {
        background: white;
        border: 1px solid #d1d5db;
        color: #111827;
        padding: 12px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
        display: inline-block;
    }

    .btn-outline-custom:hover {
        background: #f3f4f6;
        color: #111827;
    }

    @@media (max-width: 768px) {
        .info-row {
            flex-direction: column;
            gap: 6px;
        }

        .info-value {
            text-align: left;
        }
    }
</style>

<div class="delete-page">

    <div class="delete-header">
        <h1>Delete Client</h1>
        <p>Are you sure you want to remove this client from the system?</p>
    </div>

    <div class="delete-card">

        <div class="warning-box">
            ⚠ This action cannot be undone!
        </div>

        <div class="client-preview">
            <div class="client-title">@Model.FirstName @Model.LastName</div>
            <div class="client-subtitle">@Model.UserName</div>

            <div class="info-row">
                <span class="info-label">@Html.DisplayNameFor(model => model.UserName)</span>
                <span class="info-value">@Model.UserName</span>
            </div>

            <div class="info-row">
                <span class="info-label">@Html.DisplayNameFor(model => model.FirstName)</span>
                <span class="info-value">@Model.FirstName</span>
            </div>

            <div class="info-row">
                <span class="info-label">@Html.DisplayNameFor(model => model.LastName)</span>
                <span class="info-value">@Model.LastName</span>
            </div>

            <div class="info-row">
                <span class="info-label">@Html.DisplayNameFor(model => model.Address)</span>
                <span class="info-value">@Model.Address</span>
            </div>

            <div class="info-row">
                <span class="info-label">@Html.DisplayNameFor(model => model.Email)</span>
                <span class="info-value">@Model.Email</span>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <div class="actions">
                <button type="submit" class="btn-danger-custom">Delete Client</button>
                <a asp-action="Index" class="btn-outline-custom">Back to List</a>
            </div>
        </form>
    </div>
</div>