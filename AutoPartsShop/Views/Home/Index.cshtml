@{
    ViewData["Title"] = "AutoPartsShop - Начало";
}

<!-- ==================== HERO ==================== -->
<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <span class="hero-badge">Интериорни части и аксесоари</span>
        <h1 class="hero-title">UPGRADE<br><span>YOUR RIDE</span></h1>
        <p class="hero-sub">
            Премиум интериорни части з а твоя автомобил — бърза доставка, гарантирано качество.
        </p>

        <div class="hero-btns">
            <a asp-controller="Product" asp-action="Index" class="btn-hero-primary">
                Разгледай продуктите
            </a>
            <a asp-controller="Home" asp-action="About" class="btn-hero-secondary">
                За нас
            </a>
        </div>
    </div>
</section>

<!-- ==================== КАТЕГОРИИ ==================== -->
<div class="container-fluid px-4 py-5">

    <div class="section-header">
        <span class="section-line"></span>
        <h2 class="section-title">
            <i class="fas fa-th-large me-2"></i>Популярни категории
        </h2>
        <span class="section-line"></span>
    </div>

    <div class="categories-grid">
        <a href="#" class="cat-card">
            <img src="https://www.bestauto.bg/160729-large_default/universalna-tapiceriya-za-predni-sedalki-ot-eko-kozha-ss-slyat-podglavnik-cherna-komplekt-2-br.jpg">
            <div class="cat-overlay"><span>Седалки & Калъфи</span></div>
        </a>

        <a href="#" class="cat-card">
            <img src="https://s8.badu.bg/photos/645773/400x400_63f75c3a1bbe7.jpg">
            <div class="cat-overlay"><span>Волани</span></div>
        </a>

        <a href="#" class="cat-card">
            <img src="https://prioautoaccessories.com/wp-content/uploads/2024/06/Ambient-lights-from-Google-.jpg">
            <div class="cat-overlay"><span>Амбиентно осветление</span></div>
        </a>

        <a href="#" class="cat-card">
            <img src="https://evtinkobg.com/image/cache/catalog/import_gmc/9193/1830/Multimediya-kola-navigatsiya-MEiQ-iT-7-WiFi-GPS-Android-8-1-550x550.jpeg">
            <div class="cat-overlay"><span>Мултимедии</span></div>
        </a>

        <a href="#" class="cat-card">
            <img src="https://auto-mobile.bg/wp-content/uploads/2019/10/luksozen-organaizer-1.jpg">
            <div class="cat-overlay"><span>Организатори</span></div>
        </a>

        <a href="#" class="cat-card">
            <img src="https://automarket312.com/files_directory/root/ckeditor/images/Banner-ex.jpg">
            <div class="cat-overlay"><span>Аксесоари</span></div>
        </a>
    </div>

    <!-- ==================== BUTTON ONLY ==================== -->
    <div class="text-center mt-5">
        <a asp-controller="Product" asp-action="Index" class="btn-all">
            Виж всички продукти →
        </a>
    </div>

</div>

<style>
    /* HERO */
    .hero {
        height: 88vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(160deg, rgba(10,10,10,0.6), rgba(10,10,10,0.95)), url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1600&q=80') center/cover no-repeat;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 700px;
    }

    .hero-title {
        font-size: 64px;
        color: white;
        font-weight: 800;
    }

        .hero-title span {
            color: #e63312;
        }

    .hero-sub {
        color: #aaa;
        margin: 20px 0;
    }

    /* BUTTONS */
    .btn-hero-primary {
        background: #e63312;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        text-decoration: none;
    }

    .btn-hero-secondary {
        border: 1px solid #555;
        color: #ccc;
        padding: 12px 30px;
        border-radius: 8px;
        text-decoration: none;
    }

    /* SECTION */
    .section-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 30px;
    }

    .section-line {
        flex: 1;
        height: 1px;
        background: #ddd;
    }

    .section-title {
        font-weight: bold;
    }

    /* CATEGORIES */
    .categories-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 15px;
    }

    .cat-card {
        position: relative;
        height: 200px;
        border-radius: 12px;
        overflow: hidden;
    }

        .cat-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .cat-overlay {
        position: absolute;
        bottom: 0;
        width: 100%;
        background: rgba(0,0,0,0.7);
        color: white;
        text-align: center;
        padding: 10px;
    }

    /* BUTTON */
    .btn-all {
        background: linear-gradient(135deg, #e63312, #ff3c1f);
        color: white;
        padding: 14px 40px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-all:hover {
            transform: translateY(-2px);
        }
</style>