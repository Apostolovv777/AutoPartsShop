@model IEnumerable<AutoPartsShop.Models.Order.OrderIndexVM>

@{
    ViewData["Title"] = "My Orders";
    var totalOrders = Model.Count();
    var totalSpent = Model.Sum(x => x.TotalPrice);
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Poppins', sans-serif;
    }

    .orders-page {
        max-width: 1200px;
        margin: 30px auto;
    }

    .orders-header {
        text-align: center;
        margin-bottom: 25px;
    }

        .orders-header h1 {
            font-weight: 800;
            color: #111827;
            margin-bottom: 8px;
        }

        .orders-header p {
            color: #6b7280;
            margin-bottom: 0;
        }

    .orders-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        text-align: center;
    }

        .stat-card h3 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #111827;
        }

        .stat-card p {
            margin: 6px 0 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    .orders-card {
        background: white;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        padding: 20px;
    }

    .orders-table {
        margin-bottom: 0;
    }

        .orders-table thead th {
            background: #111827;
            color: white;
            border: none;
            padding: 14px;
            text-align: center;
            font-weight: 600;
        }

        .orders-table td {
            vertical-align: middle;
            text-align: center;
            padding: 14px;
        }

        .orders-table tbody tr {
            transition: 0.2s ease;
        }

            .orders-table tbody tr:hover {
                background: #f9fafb;
            }

    .product-img {
        width: 90px;
        height: 70px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
    }

    .product-name {
        font-weight: 600;
        color: #111827;
    }

    .order-date {
        color: #6b7280;
        font-size: 14px;
        white-space: nowrap;
    }

    .badge-qty {
        background: #2563eb;
        color: white;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
        min-width: 38px;
    }

    .badge-discount {
        background: #facc15;
        color: #111827;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    .price {
        color: #16a34a;
        font-weight: 700;
    }

    .total-price {
        color: #dc2626;
        font-weight: 800;
    }

    .empty-orders {
        text-align: center;
        background: white;
        padding: 45px 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    }

        .empty-orders h3 {
            color: #111827;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .empty-orders p {
            color: #6b7280;
            margin-bottom: 20px;
        }

    .btn-shop {
        display: inline-block;
        background: #111827;
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 10px;
        transition: 0.2s ease;
    }

        .btn-shop:hover {
            background: #2563eb;
            color: white;
        }

    @@media (max-width: 991.98px) {
        .orders-stats

    {
        grid-template-columns: 1fr;
    }

    }
</style>

<div class="orders-page">

    <div class="orders-header">
        <h1>📦 My Orders</h1>
        <p>Track your purchased products and order history</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-orders">
            <h3>No orders yet</h3>
            <p>You haven’t placed any orders yet. Start shopping and your orders will appear here.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-shop">Go to Products</a>
        </div>
    }
    else
    {
        <div class="orders-stats">
            <div class="stat-card">
                <h3>@totalOrders</h3>
                <p>Total Orders</p>
            </div>

            <div class="stat-card">
                <h3>@totalSpent.ToString("0.00") лв.</h3>
                <p>Total Spent</p>
            </div>
        </div>

        <div class="orders-card">
            <div class="table-responsive">
                <table class="table orders-table align-middle">
                    <thead>
                        <tr>
                            <th>Order Date</th>
                            <th>Product</th>
                            <th>Picture</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Discount</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="order-date">
                                    @item.OrderDate
                                </td>

                                <td class="product-name">
                                    @item.Product
                                </td>

                                <td>
                                    <img src="@item.Picture" alt="Product Image" class="product-img" />
                                </td>

                                <td>
                                    <span class="badge-qty">@item.Quantity</span>
                                </td>

                                <td class="price">
                                    @item.Price.ToString("0.00") лв.
                                </td>

                                <td>
                                    <span class="badge-discount">@item.Discount.ToString("0.##")%</span>
                                </td>

                                <td class="total-price">
                                    @item.TotalPrice.ToString("0.00") лв.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>