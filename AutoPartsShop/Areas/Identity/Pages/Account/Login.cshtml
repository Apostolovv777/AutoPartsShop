@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-icon">
                <i class="fa-solid fa-user-lock"></i>
            </div>
            <h1 class="auth-title">Добре дошъл</h1>
            <p class="auth-subtitle">Влез в своя AutoPartShop акаунт</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>

            <div class="field-group">
                <label asp-for="Input.UserName" class="field-label">
                    Потребителско име
                </label>
                <input asp-for="Input.UserName"
                       class="field-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="Въведи потребителско име" />
                <span asp-validation-for="Input.UserName" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Input.Password" class="field-label">
                    Парола
                </label>
                <input asp-for="Input.Password"
                       class="field-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Въведи парола" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <button id="login-submit" type="submit" class="btn-auth">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Вход
            </button>
        </form>

        <div class="auth-footer-text">
            Нямаш акаунт?
            <a asp-page="./Register">Регистрация</a>
        </div>

    </div>
</div>

<style>
    .auth-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        border-radius: 22px;
        padding: 36px 30px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .auth-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 18px;
        background: linear-gradient(135deg, #111827, #1f2937);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        box-shadow: 0 10px 24px rgba(17, 24, 39, 0.18);
    }

    .auth-title {
        color: #111827;
        font-size: 38px;
        font-weight: 800;
        margin: 0 0 8px 0;
    }

    .auth-subtitle {
        color: #6b7280;
        margin: 0;
        font-size: 15px;
    }

    .field-group {
        margin-bottom: 18px;
    }

    .field-label {
        display: block;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
        letter-spacing: 0.4px;
    }

    .field-input {
        width: 100%;
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #111827;
        border-radius: 12px;
        padding: 14px 16px;
        font-size: 14px;
        outline: none;
        transition: 0.2s ease;
    }

        .field-input::placeholder {
            color: #9ca3af;
        }

        .field-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

    .field-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
    }

    .alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .btn-auth {
        width: 100%;
        background: #111827;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        margin-top: 8px;
    }

        .btn-auth:hover {
            background: #2563eb;
        }

    .auth-footer-text {
        text-align: center;
        margin-top: 18px;
        color: #6b7280;
        font-size: 14px;
    }

        .auth-footer-text a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

            .auth-footer-text a:hover {
                text-decoration: underline;
            }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}