@model IEnumerable<AutoPartsShop.Models.Order.OrderIndexVM>

@{
    ViewData["Title"] = "All Orders";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Poppins', sans-serif;
    }

    .page-title {
        text-align: center;
        margin-top: 20px;
        margin-bottom: 20px;
    }

        .page-title h2 {
            font-weight: 700;
        }

    .table-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        max-width: 1200px;
        margin: 0 auto;
    }

    .custom-table {
        width: 100%;
    }

        .custom-table thead {
            background: #111827;
            color: white;
        }

            .custom-table thead th {
                padding: 14px;
                font-weight: 500;
                font-size: 14px;
            }

        .custom-table tbody tr {
            transition: 0.2s ease;
        }

            .custom-table tbody tr:hover {
                background: #f3f4f6;
            }

        .custom-table td {
            padding: 12px;
            font-size: 14px;
        }

    .product-img {
        width: 80px;
        height: 65px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .badge-blue {
        background: #2563eb;
        color: white;
        padding: 6px 10px;
        border-radius: 10px;
        font-size: 13px;
    }

    .badge-yellow {
        background: #facc15;
        color: #111;
        padding: 6px 10px;
        border-radius: 10px;
        font-size: 13px;
    }

    .price-green {
        color: #16a34a;
        font-weight: 600;
    }

    .price-red {
        color: #dc2626;
        font-weight: 700;
    }
</style>

<div class="container">

    <!-- TITLE -->
    <div class="page-title">
        <h2>All Orders</h2>
        <p class="text-muted">Manage and review customer orders</p>
    </div>

    <!-- TABLE CARD -->
    <div class="table-card">

        <div class="table-responsive">

            <table class="table custom-table text-center align-middle mb-0">

                <thead>
                    <tr>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Discount</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="text-muted">
                                @item.OrderDate
                            </td>

                            <td class="fw-semibold">
                                @item.User
                            </td>

                            <td>
                                @item.Product
                            </td>

                            <td>
                                <img src="@item.Picture" class="product-img" />
                            </td>

                            <td>
                                <span class="badge-blue">
                                    @item.Quantity
                                </span>
                            </td>

                            <td class="price-green">
                                $@item.Price
                            </td>

                            <td>
                                <span class="badge-yellow">
                                    @item.Discount%
                                </span>
                            </td>

                            <td class="price-red">
                                $@item.TotalPrice
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}